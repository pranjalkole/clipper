# ==============================================================================
# Enterprise Multimodal Semantic Search & Agentic Intelligence Platform Config
# ==============================================================================

# Application Settings
APP_NAME="Multimodal Search Platform"
APP_ENV="development"
DEBUG=false
LOG_LEVEL="INFO"

# LLM Provider Configuration
# Toggle between "google_ai_studio" (free tier) and "vertex_ai" (enterprise GCP)
LLM_PROVIDER="google_ai_studio"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"
VERTEX_PROJECT=
VERTEX_LOCATION="us-central1"

# Multimodal Embedder (MobileCLIP2-S0)
MODEL_NAME="MobileCLIP2-S0"
PRETRAINED_TAG="dfndr2b"
EMBEDDING_DIM=512
DEVICE="auto"
CHECKPOINT_DIR="./checkpoints"

# Qdrant Vector DB Configuration
# Use QDRANT_PATH for local embedded storage, or QDRANT_HOST/PORT for Docker/cloud
QDRANT_PATH="./data/qdrant_storage"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_NAME="fashion_catalog"

# Search & Multi-Agent Reflection Thresholds
MIN_CONFIDENCE_SCORE=0.70
TOP_K_CANDIDATES=10
MAX_REFLECTION_RETRIES=2
